# Copy to .env (never commit it). Every variable is optional.
LAUNCH_CREW_PROVIDER=ollama             # ollama | anthropic | fake
LAUNCH_CREW_MODEL=qwen3:4b              # claude-sonnet-5-5 for anthropic
LAUNCH_CREW_MANAGER_MODEL=              # manager + planner model; default: LAUNCH_CREW_MODEL
OLLAMA_HOST=http://127.0.0.1:11434      # loopback only unless the next line is 1
LAUNCH_CREW_ALLOW_REMOTE_OLLAMA=
LAUNCH_CREW_TEMPERATURE=0
LAUNCH_CREW_MODE=planning               # sequential | hierarchical | planning
LAUNCH_CREW_MANAGER=agent               # agent (custom manager_agent) | llm (manager_llm)
LAUNCH_CREW_MAX_DELEGATIONS=8
LAUNCH_CREW_MAX_ITER=6
LAUNCH_CREW_GUARDRAIL_RETRIES=2
LAUNCH_CREW_COMPLEXITY_THRESHOLD=3
LAUNCH_CREW_DATA_DIR=                   # folder with products/segments/competitors.csv
LAUNCH_CREW_FAKE_LATENCY=0
LAUNCH_CREW_VERBOSE=
# Only for the optional Anthropic adapter (pip install ".[anthropic]"):
# ANTHROPIC_API_KEY=
# Telemetry: the package forces these on import, you don't need to set them.
# CREWAI_DISABLE_TELEMETRY=true OTEL_SDK_DISABLED=true CREWAI_TRACING_ENABLED=false
